# === YouTube Shorts Automator Configuration ===

# --- OpenAI (required for script generation) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Reddit (optional — for fetching real AITA posts) ---
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=youtube-shorts-automator/0.1

# Comma-separated subreddit list
SUBREDDITS=["AmItheAsshole","tifu","pettyrevenge","MaliciousCompliance"]

# --- YouTube Upload ---
# Download client_secrets.json from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json
YOUTUBE_CATEGORY_ID=22

# --- Video Settings ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FONT_SIZE=48
FONT_COLOR=white
MAX_VIDEO_DURATION=59

# --- Background Videos ---
BACKGROUND_VIDEOS_DIR=assets/backgrounds

# --- Scheduler ---
VIDEOS_PER_DAY=3
SCHEDULE_INTERVAL_HOURS=8

# --- Output ---
OUTPUT_DIR=output
